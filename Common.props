<Project>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10</LangVersion>
    <Configurations>Debug;Release;Profiling;Editor</Configurations>
    <!-- The SDK defaults Configuration after this file, OutputPath needs it now -->
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <!-- Keep Properties/AssemblyInfo.cs, buildtools replace writes the version there -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- KSP install to build against. Without KSP_DIR_BUILD, KSPBuildTools uses the KSP_ROOT
         environment variable, then the Steam install. -->
    <KSPBT_GameRoot Condition=" '$(KSPBT_GameRoot)' == '' And '$(KSP_DIR_BUILD)' != '' ">$(KSP_DIR_BUILD)</KSPBT_GameRoot>
    <!-- Never run CKAN against the install, CI installs dependencies in its own step -->
    <KSPBT_InstallCKANDependencies>false</KSPBT_InstallCKANDependencies>
    <!-- buildtools does these: AssemblyInfo.cs, FAR.version from FAR.version.in, and the postbuild copy -->
    <KSPBT_GenerateAssemblyAttribute>false</KSPBT_GenerateAssemblyAttribute>
    <KSPBT_GenerateDependencyAttributes>false</KSPBT_GenerateDependencyAttributes>
    <KSPBT_GenerateVersionFile>false</KSPBT_GenerateVersionFile>
    <KSPBT_CopyDLLsToPluginFolder>false</KSPBT_CopyDLLsToPluginFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
  </ItemGroup>
</Project>
