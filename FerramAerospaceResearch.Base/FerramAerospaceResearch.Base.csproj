<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FerramAerospaceResearch</RootNamespace>
    <AssemblyName>FerramAerospaceResearch.Base</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Base is Unity-only (the Unity project builds against it) and must not see Assembly-CSharp -->
    <KSPBT_ReferenceGameAssemblies>false</KSPBT_ReferenceGameAssemblies>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;ASSERT;LOG_TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;INFO</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Profiling' ">
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;INFO;ENABLE_PROFILER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Editor' ">
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;ASSERT;LOG_TRACE;ENABLE_UNITY_COLLECTIONS_CHECKS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ModReference Include="Unity.Burst">
      <DLLPath>GameData/000_KSPBurst/Plugins/Unity.Burst.dll</DLLPath>
      <CKANIdentifier>KSPBurst</CKANIdentifier>
    </ModReference>
    <ModReference Include="Unity.Burst.Unsafe">
      <DLLPath>GameData/000_KSPBurst/Plugins/Unity.Burst.Unsafe.dll</DLLPath>
      <CKANIdentifier>KSPBurst</CKANIdentifier>
    </ModReference>
    <ModReference Include="Unity.Collections">
      <DLLPath>GameData/000_KSPBurst/Plugins/Unity.Collections.dll</DLLPath>
      <CKANIdentifier>KSPBurst</CKANIdentifier>
    </ModReference>
    <ModReference Include="Unity.Jobs">
      <DLLPath>GameData/000_KSPBurst/Plugins/Unity.Jobs.dll</DLLPath>
      <CKANIdentifier>KSPBurst</CKANIdentifier>
    </ModReference>
    <ModReference Include="Unity.Mathematics">
      <DLLPath>GameData/000_KSPBurst/Plugins/Unity.Mathematics.dll</DLLPath>
      <CKANIdentifier>KSPBurst</CKANIdentifier>
    </ModReference>
  </ItemGroup>

  <!-- The Unity project (Unity/FerramAerospaceResearch) needs Base built against the editor's CoreModule -->
  <Target Name="FARUseEditorCoreModule" BeforeTargets="ResolveAssemblyReferences" Condition=" '$(Configuration)' == 'Editor' ">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition=" '%(Filename)' == 'UnityEngine.CoreModule' " />
      <Reference Include="$(UNITY_EDITOR_MANAGED_DIR)\UnityEngine.CoreModule.dll">
        <Private>False</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
