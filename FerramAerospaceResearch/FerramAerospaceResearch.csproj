<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FerramAerospaceResearch</RootNamespace>
    <AssemblyName>FerramAerospaceResearch</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- KSPCommunityFixes is built x64, FAR AnyCPU -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;ASSERT;LOG_TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;INFO</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Profiling' ">
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;INFO;ENABLE_PROFILER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Editor' ">
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;INFO</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- KSPBuildTools doesn't reference KSPAssets on its own -->
    <Reference Include="KSPAssets">
      <HintPath>$(KSPBT_ManagedPath)\KSPAssets.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Scale_Redist">
      <HintPath>..\GameData\FerramAerospaceResearch\Plugins\Scale_Redist.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <ModReference Include="ModularFlightIntegrator">
      <DLLPath>GameData/ModularFlightIntegrator/ModularFlightIntegrator.dll</DLLPath>
      <CKANIdentifier>ModularFlightIntegrator</CKANIdentifier>
    </ModReference>
    <ModReference Include="KSPCommunityFixes">
      <DLLPath>GameData/KSPCommunityFixes/Plugins/KSPCommunityFixes.dll</DLLPath>
      <CKANIdentifier>KSPCommunityFixes</CKANIdentifier>
    </ModReference>
    <ModReference Include="Unity.Mathematics">
      <DLLPath>GameData/000_KSPBurst/Plugins/Unity.Mathematics.dll</DLLPath>
      <CKANIdentifier>KSPBurst</CKANIdentifier>
    </ModReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FerramAerospaceResearch.Base\FerramAerospaceResearch.Base.csproj" />
    <ProjectReference Include="..\ferramGraph\ferramGraph.csproj" />
  </ItemGroup>
</Project>
