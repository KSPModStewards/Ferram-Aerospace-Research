{
    "variables": {
        "KSP_DIR_INSTALL": "$(env:KSP_ROOT)"
    },
    "package": {
        "compression": null
    },
    "replace": {
        "regex": [
            {
                "pattern": "$(ModName).Base/Version.cs",
                "substitutions": [
                    {
                        "search": "GitSha = null",
                        "replace": "GitSha = \"$(env:GITHUB_SHA)\""
                    }
                ]
            }
        ]
    }
}
