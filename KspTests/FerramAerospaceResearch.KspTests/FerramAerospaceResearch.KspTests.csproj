<Project Sdk="Microsoft.NET.Sdk">
    <!--
        FAR's in-game tests: [UITest]s the KspTest harness runs in a KSP session, each checking what FAR does in the
        game (loading, voxels, aero, wings, heating, the GUI) against what it should. The Far* ones are explicit, run by
        name only: the long thermal flights, those flown on AtmosphereAutopilot and those still to port. Loaded by KSP,
        so net48, built against the install in KspDir (see ../Directory.Build.props) and against the FAR build the runs
        lay over the instance (FarGameData, else this repository's GameData/FerramAerospaceResearch), whose internals it
        sees (InternalsVisibleTo). FerramAerospaceResearch.KspTests.Run runs them with dotnet test.
    -->
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>9</LangVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <RootNamespace>FerramAerospaceResearch.KspTests</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
        <FarPlugins Condition="'$(FarPlugins)' == '' and '$(FarGameData)' != ''">$(FarGameData)/Plugins</FarPlugins>
        <FarPlugins Condition="'$(FarPlugins)' == ''">$(MSBuildThisFileDirectory)../../GameData/FerramAerospaceResearch/Plugins</FarPlugins>
    </PropertyGroup>
    <PropertyGroup>
        <!-- the harness and these modules from the KspTest submodule, compile-time only: the runner deploys them -->
        <KspTestModules>Far;Trajectories;AtmosphereAutopilot</KspTestModules>
    </PropertyGroup>
    <ItemGroup>
        <!-- the game loads FAR from GameData: compiled against, never copied -->
        <Reference Include="FerramAerospaceResearch" HintPath="$(FarPlugins)/FerramAerospaceResearch.dll" Private="false" />
        <Reference Include="FerramAerospaceResearch.Base" HintPath="$(FarPlugins)/FerramAerospaceResearch.Base.dll" Private="false" />
        <!-- VoxelPoolTests, ThermalAreaTests and FarThermalModeTests patch FAR; the harness has the game load GameData/000_Harmony -->
        <PackageReference Include="Lib.Harmony" Version="2.2.1" ExcludeAssets="runtime" PrivateAssets="all" />
    </ItemGroup>
    <Import Project="$(KspTestRoot)/build/KspTest.FromSource.targets" />
</Project>
